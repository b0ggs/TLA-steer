+def test_wraps_preserves_keyword_forwarding():
+    calls = []
+
+    def wrapped_func(a, b=2, *, c=3):
+        return a, b, c
+
+    @wraps(wrapped_func)
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+        return wrapped_func(*args, **kwargs)
+
+    assert wrapper(1, b=4, c=5) == (1, 4, 5)
+    assert calls == [((1,), {'b': 4, 'c': 5})]
+
+
+def test_wraps_keeps_regular_parameters_positional_with_varargs():
+    calls = []
+
+    def wrapped_func(a, b=2, *args, c=3):
+        return a, b, args, c
+
+    @wraps(wrapped_func)
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+        return wrapped_func(*args, **kwargs)
+
+    assert wrapper(1, 4, 5, c=6) == (1, 4, (5,), 6)
+    assert calls == [((1, 4, 5), {'c': 6})]
+
+
+@pytest.mark.skipif(not hasattr(inspect, 'Parameter'),
+                    reason='positional-only parameters are not supported')
+def test_wraps_preserves_positional_only_parameters():
+    namespace = {}
+    try:
+        exec('def wrapped_func(a, b=2, /, c=3, *, d=4):\n'
+             '    return a, b, c, d', namespace)
+    except SyntaxError:
+        pytest.skip('positional-only parameter syntax is not supported')
+    wrapped_func = namespace['wrapped_func']
+    calls = []
+
+    @wraps(wrapped_func)
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+        return wrapped_func(*args, **kwargs)
+
+    assert wrapper(1, c=5, d=6) == (1, 2, 5, 6)
+    assert calls == [((1, 2), {'c': 5, 'd': 6})]
+    params = inspect.signature(wrapper).parameters
+    assert params['a'].kind is inspect.Parameter.POSITIONAL_ONLY
+    assert params['b'].kind is inspect.Parameter.POSITIONAL_ONLY
+
