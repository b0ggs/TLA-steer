+def test_wraps_preserves_keyword_forwarding():
+    calls = []
+
+    def func(a, b=2, *, c, d=4):
+        return a, b, c, d
+
+    @wraps(func)
+    def wrapped(*args, **kwargs):
+        calls.append((args, kwargs))
+
+    wrapped(1, b=3, c=5, d=6)
+    assert calls == [((1,), {'b': 3, 'c': 5, 'd': 6})]
+
+
+def test_wraps_varargs_keep_regular_parameters_positional():
+    calls = []
+
+    def func(a, b=2, *items, c=3, **kwargs):
+        return a, b, items, c, kwargs
+
+    @wraps(func)
+    def wrapped(*args, **kwargs):
+        calls.append((args, kwargs))
+
+    wrapped(1, 4, 5, c=6, d=7)
+    assert calls == [((1, 4, 5), {'c': 6, 'd': 7})]
+
+
+def test_wraps_preserves_positional_only_parameters():
+    if sys.version_info < (3, 8):
+        pytest.skip('positional-only syntax requires Python 3.8+')
+
+    namespace = {}
+    exec('def func(a=1, /, b=2):\n    return a, b', namespace)
+    func = namespace['func']
+    calls = []
+
+    @wraps(func)
+    def wrapped(*args, **kwargs):
+        calls.append((args, kwargs))
+
+    assert inspect.signature(wrapped, follow_wrapped=False) == inspect.signature(func)
+    wrapped(3, b=4)
+    assert calls == [((3,), {'b': 4})]
+
+    with pytest.raises(TypeError):
+        wrapped(a=3)
+
+
