+    return
+
+
+def test_wraps_preserves_keyword_forwarding():
+    calls = []
+
+    def target(a, b=2, *, c=3):
+        pass
+
+    @wraps(target)
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+
+    wrapper(1)
+    wrapper(1, b=4, c=5)
+    assert calls == [
+        ((1,), {'b': 2, 'c': 3}),
+        ((1,), {'b': 4, 'c': 5}),
+    ]
+
+
+def test_wraps_preserves_expected_keyword_forwarding():
+    calls = []
+
+    def target(a):
+        pass
+
+    @wraps(target, expected=[('extra', 2)])
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+
+    wrapper(1, extra=3)
+    assert calls == [((1,), {'extra': 3})]
+
+
+def test_wraps_varargs_prevent_keyword_collision():
+    calls = []
+
+    def target(a, b=2, *items, c=3):
+        pass
+
+    @wraps(target)
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+
+    wrapper(1, 4, 5, c=6)
+    assert calls == [((1, 4, 5), {'c': 6})]
+
+
+def test_wraps_preserves_positional_only_parameters():
+    if sys.version_info < (3, 8):
+        pytest.skip('Python-level positional-only parameters require Python 3.8')
+
+    calls = []
+    namespace = {}
+    exec('def target(a, /, b=2): pass', namespace)
+    target = namespace['target']
+
+    @wraps(target)
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+
+    assert str(inspect.signature(wrapper, follow_wrapped=False)) == '(a, /, b=2)'
+    wrapper(1, b=3)
+    assert calls == [((1,), {'b': 3})]
 
     return
 
