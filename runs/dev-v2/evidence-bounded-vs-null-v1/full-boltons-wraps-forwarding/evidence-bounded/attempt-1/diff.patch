+def test_wraps_preserves_keyword_forwarding():
+    calls = []
+
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+        return args, kwargs
+
+    def regular(a, b=2):
+        pass
+
+    wrapped = wraps(regular)(wrapper)
+    wrapped(1, b=3)
+    assert calls.pop() == ((1,), {'b': 3})
+
+    wrapped_expected = wraps(regular, expected=[('c', 4)])(wrapper)
+    wrapped_expected(1, c=5)
+    assert calls.pop() == ((1,), {'b': 2, 'c': 5})
+
+
+def test_wraps_preserves_positional_and_varargs_forwarding():
+    calls = []
+
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+
+    if sys.version_info >= (3, 8):
+        namespace = {}
+        exec('def positional_only(a, b=2, /, c=3, *, d=4): pass', namespace)
+        wrapped_posonly = wraps(namespace['positional_only'])(wrapper)
+        assert str(inspect.signature(wrapped_posonly, follow_wrapped=False)) == \
+            '(a, b=2, /, c=3, *, d=4)'
+        wrapped_posonly(1, 2, c=5, d=6)
+        assert calls.pop() == ((1, 2), {'c': 5, 'd': 6})
+
+    def variadic(a, b=2, *args, c=3, **kwargs):
+        pass
+
+    wrapped_variadic = wraps(variadic)(wrapper)
+    wrapped_variadic(1, 4, 5, c=6, d=7)
+    assert calls.pop() == ((1, 4, 5), {'c': 6, 'd': 7})
+
