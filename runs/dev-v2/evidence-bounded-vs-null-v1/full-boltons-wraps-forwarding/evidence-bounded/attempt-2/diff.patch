+def test_wraps_preserves_keyword_forwarding():
+    def capture(*args, **kwargs):
+        return args, kwargs
+
+    def defaults(a, b=2):
+        pass
+
+    assert wraps(defaults)(capture)(1, b=3) == ((1,), {'b': 3})
+
+    if sys.version_info >= (3, 8):
+        namespace = {}
+        exec('def positional_only(a=1, /, b=2, *, c=3): pass', namespace)
+        positional_only = namespace['positional_only']
+        assert wraps(positional_only)(capture)(b=4, c=5) == (
+            (1,), {'b': 4, 'c': 5})
+
+    def variadic(a, b=2, *args, c=3, **kwargs):
+        pass
+
+    assert wraps(variadic)(capture)(1, 4, 5, c=6, extra=7) == (
+        (1, 4, 5), {'c': 6, 'extra': 7})
+
+
