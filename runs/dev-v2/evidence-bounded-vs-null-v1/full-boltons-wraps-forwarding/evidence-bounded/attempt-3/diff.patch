+def test_wraps_preserves_keyword_forwarding():
+    calls = []
+
+    def wrapped(a, b=2, *, c=3):
+        pass
+
+    @wraps(wrapped)
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+
+    wrapper(1, b=4, c=5)
+    assert calls == [((1,), {'b': 4, 'c': 5})]
+
+
+def test_wraps_varargs_keep_regular_parameters_positional():
+    calls = []
+
+    def wrapped(a, b=2, *args, **kwargs):
+        pass
+
+    @wraps(wrapped)
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+
+    wrapper(1, 2, 3, flag=True)
+    assert calls == [((1, 2, 3), {'flag': True})]
+
+
+@pytest.mark.skipif(sys.version_info < (3, 8),
+                    reason='positional-only syntax requires Python 3.8')
+def test_wraps_preserves_positional_only_parameters():
+    calls = []
+
+    namespace = {}
+    exec('def wrapped(a, b=2, /, c=3, *, d=4): pass', namespace)
+    wrapped = namespace['wrapped']
+
+    @wraps(wrapped)
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+
+    wrapper(1, 2, c=5, d=6)
+    assert inspect.signature(wrapper) == inspect.signature(wrapped)
+    assert calls == [((1, 2), {'c': 5, 'd': 6})]
+
