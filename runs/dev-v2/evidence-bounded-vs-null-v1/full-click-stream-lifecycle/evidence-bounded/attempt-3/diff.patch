+
+
+def test_named_text_wrapper_does_not_close_shared_buffer():
+    stream = BytesIO()
+    wrappers = [
+        _NamedTextIOWrapper(stream, name="<first>", mode="w", encoding="utf-8"),
+        _NamedTextIOWrapper(stream, name="<second>", mode="w", encoding="utf-8"),
+    ]
+
+    wrappers[0].write("first")
+    del wrappers[0]
+    gc.collect()
+    assert stream.getvalue() == b"first"
+
+    wrappers[0].write(" second")
+    del wrappers[0]
+    gc.collect()
+    assert stream.getvalue() == b"first second"
+
+
+def test_isolation_streams_remain_readable_after_cleanup(runner):
+    with runner.isolation() as streams:
+        click.echo("stdout")
+        click.echo("stderr", err=True)
+
+    gc.collect()
+    assert streams[0].getvalue() == b"stdout\n"
+    assert streams[1].getvalue() == b"stderr\n"
+    assert streams[2].getvalue() == b"stdout\nstderr\n"
