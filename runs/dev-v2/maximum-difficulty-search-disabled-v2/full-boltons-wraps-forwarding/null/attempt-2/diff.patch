+def test_wraps_preserves_keyword_forwarding():
+    calls = []
+
+    def target(a, b=2, *, c=3):
+        return a, b, c
+
+    @wraps(target)
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+        return target(*args, **kwargs)
+
+    assert wrapper(1, b=4, c=5) == (1, 4, 5)
+    assert calls == [((1,), {'b': 4, 'c': 5})]
+
+
+def test_wraps_varargs_keep_regular_parameters_positional():
+    calls = []
+
+    def target(a, b=2, *args, c=3, **kwargs):
+        return a, b, args, c, kwargs
+
+    @wraps(target)
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+        return target(*args, **kwargs)
+
+    assert wrapper(1, 4, 5, c=6, d=7) == (1, 4, (5,), 6, {'d': 7})
+    assert calls == [((1, 4, 5), {'c': 6, 'd': 7})]
+
+
+@pytest.mark.skipif(sys.version_info < (3, 8),
+                    reason='positional-only syntax requires Python 3.8')
+def test_wraps_preserves_positional_only_parameters():
+    calls = []
+    namespace = {}
+    exec('def target(a, /, b=2, *, c=3):\n    return a, b, c', namespace)
+    target = namespace['target']
+
+    @wraps(target)
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+        return target(*args, **kwargs)
+
+    assert str(inspect.signature(wrapper, follow_wrapped=False)) == (
+        '(a, /, b=2, *, c=3)')
+    assert wrapper(1, b=4, c=5) == (1, 4, 5)
+    assert calls == [((1,), {'b': 4, 'c': 5})]
+    with pytest.raises(TypeError):
+        wrapper(a=1)
+
