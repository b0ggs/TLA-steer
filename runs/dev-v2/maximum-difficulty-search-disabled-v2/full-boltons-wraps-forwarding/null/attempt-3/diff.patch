+def test_wraps_preserves_keyword_forwarding():
+    def capture(*args, **kwargs):
+        return args, kwargs
+
+    def regular(a, b=2):
+        pass
+
+    wrapped = wraps(regular)(capture)
+    assert wrapped(1, b=3) == ((1,), {'b': 3})
+    assert wrapped(1, 3) == ((1,), {'b': 3})
+
+    def with_expected(a, b=2):
+        pass
+
+    wrapped = wraps(with_expected, expected=[('c', 4)])(capture)
+    assert wrapped(1, b=3, c=5) == ((1,), {'b': 3, 'c': 5})
+
+
+def test_wraps_forwarding_with_parameter_kinds():
+    def capture(*args, **kwargs):
+        return args, kwargs
+
+    def with_varargs(a, b=2, *args, c=3, **kwargs):
+        pass
+
+    wrapped = wraps(with_varargs)(capture)
+    assert wrapped(1, 4, 5, c=6, d=7) == (
+        (1, 4, 5), {'c': 6, 'd': 7})
+
+    if sys.version_info < (3, 8):
+        pytest.skip('positional-only syntax requires Python 3.8')
+
+    namespace = {}
+    exec('def with_posonly(a, b=2, /, c=3, *, d=4): pass', namespace)
+    with_posonly = namespace['with_posonly']
+
+    wrapped = wraps(with_posonly)(capture)
+    assert str(inspect.signature(wrapped, follow_wrapped=False)) == (
+        '(a, b=2, /, c=3, *, d=4)')
+    assert wrapped(1, c=5, d=6) == ((1, 2), {'c': 5, 'd': 6})
+
