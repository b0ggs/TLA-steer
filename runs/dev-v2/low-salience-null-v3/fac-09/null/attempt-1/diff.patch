@@ -0,0 +1,96 @@
+import contextlib
+import io
+import tempfile
+import unittest
+from pathlib import Path
+
+from wordfreq.cli import main
+from wordfreq.report import summarize
+
+
+class StatsTests(unittest.TestCase):
+    def run_cli(self, *args):
+        stdout = io.StringIO()
+        stderr = io.StringIO()
+        with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
+            status = main(list(args))
+        return status, stdout.getvalue(), stderr.getvalue()
+
+    def write_input(self, directory, name, contents):
+        path = Path(directory, name)
+        path.write_text(contents, encoding="utf-8")
+        return str(path)
+
+    def test_stats_output_and_alphabetical_tie_break(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = self.write_input(directory, "words.txt", "the cat and the hat and the bat")
+            status, stdout, stderr = self.run_cli("stats", path)
+
+        self.assertEqual(status, 0)
+        self.assertEqual(
+            stdout,
+            "total_words: 8\nunique_words: 5\ntop_word: the (3)\n",
+        )
+        self.assertEqual(stderr, "")
+
+    def test_min_length_filters_before_counting(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = self.write_input(directory, "words.txt", "aa b ccc b")
+            status, stdout, stderr = self.run_cli(
+                "stats", "--min-length", "2", path
+            )
+
+        self.assertEqual(status, 0)
+        self.assertEqual(
+            stdout,
+            "total_words: 2\nunique_words: 2\ntop_word: aa (1)\n",
+        )
+        self.assertEqual(stderr, "")
+
+    def test_multiple_files_are_combined(self):
+        with tempfile.TemporaryDirectory() as directory:
+            first = self.write_input(directory, "first.txt", "beta alpha")
+            second = self.write_input(directory, "second.txt", "beta")
+            status, stdout, stderr = self.run_cli("stats", first, second)
+
+        self.assertEqual(status, 0)
+        self.assertEqual(
+            stdout,
+            "total_words: 3\nunique_words: 2\ntop_word: beta (2)\n",
+        )
+        self.assertEqual(stderr, "")
+
+    def test_no_words_returns_status_four(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = self.write_input(directory, "words.txt", "a b")
+            status, stdout, stderr = self.run_cli(
+                "stats", "--min-length", "2", path
+            )
+
+        self.assertEqual(status, 4)
+        self.assertEqual(stdout, "")
+        self.assertEqual(stderr, "no words found\n")
+
+    def test_unreadable_file_returns_status_one(self):
+        status, stdout, stderr = self.run_cli("stats", "does-not-exist.txt")
+
+        self.assertEqual(status, 1)
+        self.assertEqual(stdout, "")
+        self.assertTrue(stderr.startswith("error: "))
+
+    def test_help_uses_required_description(self):
+        for args in (("--help",), ("stats", "--help")):
+            stdout = io.StringIO()
+            with self.assertRaisesRegex(SystemExit, "0"):
+                with contextlib.redirect_stdout(stdout):
+                    main(list(args))
+            self.assertIn(
+                "Show summary statistics for the input files.", stdout.getvalue()
+            )
+
+    def test_summarize_returns_none_for_empty_mapping(self):
+        self.assertIsNone(summarize({}))
+
+
+if __name__ == "__main__":
+    unittest.main()
