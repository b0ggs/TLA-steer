@@ -0,0 +1,94 @@
+import contextlib
+import io
+import json
+import os
+import tempfile
+import unittest
+from pathlib import Path
+
+from dirlens.cli import main
+from dirlens.report import newest_entries
+
+
+class NewestTests(unittest.TestCase):
+    def test_default_limit_is_five(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            for index in range(6):
+                path = root / ("%d.txt" % index)
+                path.write_text(str(index))
+                os.utime(path, (1609459200 + index, 1609459200 + index))
+
+            self.assertEqual(len(newest_entries(root)), 5)
+
+    def test_entries_are_newest_first_with_path_tiebreak_and_limit(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            old = root / "old.txt"
+            tied_b = root / "b.txt"
+            tied_a = root / "nested" / "a.txt"
+            tied_a.parent.mkdir()
+            for path in (old, tied_b, tied_a):
+                path.write_text(path.name)
+            os.utime(old, (1609459200, 1609459200))
+            os.utime(tied_b, (1609459260, 1609459260))
+            os.utime(tied_a, (1609459260, 1609459260))
+
+            self.assertEqual(
+                newest_entries(root, limit=2),
+                [
+                    {"path": "b.txt", "mtime": "2021-01-01T00:01:00Z"},
+                    {
+                        "path": "nested/a.txt",
+                        "mtime": "2021-01-01T00:01:00Z",
+                    },
+                ],
+            )
+
+    def test_json_mode_outputs_only_path_and_mtime(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            path = root / "file.txt"
+            path.write_text("content")
+            os.utime(path, (1609459200, 1609459200))
+            stdout = io.StringIO()
+
+            with contextlib.redirect_stdout(stdout):
+                status = main(["newest", str(root), "--json"])
+
+            self.assertEqual(status, 0)
+            self.assertEqual(
+                json.loads(stdout.getvalue()),
+                [{"path": "file.txt", "mtime": "2021-01-01T00:00:00Z"}],
+            )
+
+    def test_fractional_mtime_controls_order_but_is_truncated_in_output(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            first = root / "a.txt"
+            second = root / "z.txt"
+            first.write_text("first")
+            second.write_text("second")
+            os.utime(first, ns=(1609459200100000000, 1609459200100000000))
+            os.utime(second, ns=(1609459200900000000, 1609459200900000000))
+
+            self.assertEqual(
+                newest_entries(root),
+                [
+                    {"path": "z.txt", "mtime": "2021-01-01T00:00:00Z"},
+                    {"path": "a.txt", "mtime": "2021-01-01T00:00:00Z"},
+                ],
+            )
+
+    def test_empty_directory_outputs_empty_json_array(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            stdout = io.StringIO()
+            with contextlib.redirect_stdout(stdout):
+                status = main(["newest", tmp, "--json"])
+
+            self.assertEqual(status, 0)
+            self.assertEqual(stdout.getvalue(), "[]\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
