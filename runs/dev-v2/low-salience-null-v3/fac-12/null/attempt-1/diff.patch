+
+
+def newest_entries(root, limit=5):
+    """Return the most recently modified files as path/mtime dictionaries."""
+    rows = []
+    for path in iter_files(root):
+        rows.append((path.stat().st_mtime_ns, rel_posix(path, root)))
+    rows.sort(key=[REDACTED] row: (-row[0], row[1]))
+
+    entries = []
+    for mtime_ns, relative_path in rows[:limit]:
+        whole_seconds = mtime_ns // 1_000_000_000
+        timestamp = datetime.fromtimestamp(whole_seconds, timezone.utc).strftime(
+            "%Y-%m-%dT%H:%M:%SZ"
+        )
+        entries.append({"path": relative_path, "mtime": timestamp})
+    return entries
