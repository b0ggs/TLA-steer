+
+def newest_entries(root, limit=5):
+    """Return newest file entries, ordered by mtime descending then path."""
+    if limit < 0:
+        raise ValueError("limit must be non-negative")
+
+    rows = []
+    for path in iter_files(root):
+        relative_path = rel_posix(path, root)
+        mtime_ns = path.stat().st_mtime_ns
+        rows.append((mtime_ns, relative_path))
+
+    rows.sort(key=[REDACTED] row: (-row[0], row[1]))
+    entries = []
+    for mtime_ns, relative_path in rows[:limit]:
+        whole_seconds = mtime_ns // 1_000_000_000
+        mtime = datetime.fromtimestamp(whole_seconds, timezone.utc).strftime(
+            "%Y-%m-%dT%H:%M:%SZ"
+        )
+        entries.append({"path": relative_path, "mtime": mtime})
+    return entries
