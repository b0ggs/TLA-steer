+    def test_weighted_mean(self):
+        samples = [
+            {"metric": "cpu", "value": 10.0, "weight": 1.0},
+            {"metric": "cpu", "value": 20.0, "weight": 3.0},
+        ]
+        result = rollup(samples)["cpu"]
+        self.assertAlmostEqual(result["mean"], 17.5)
+        self.assertAlmostEqual(result["weight_total"], 4.0)
+
+        samples = [
+            {"metric": "cpu", "value": 4.0},
+            {"metric": "cpu", "value": 8.0, "weight": 3.0},
+        ]
+        result = rollup(samples)["cpu"]
+        self.assertAlmostEqual(result["mean"], 7.0)
+        self.assertAlmostEqual(result["weight_total"], 4.0)
+
+        result = rollup([{"metric": "cpu", "value": 5.0, "weight": None}])[
+            "cpu"
+        ]
+        self.assertAlmostEqual(result["mean"], 5.0)
+        self.assertAlmostEqual(result["weight_total"], 1.0)
+
 
 if __name__ == "__main__":
     unittest.main()
