 from collections import defaultdict
 
 import pytest
@@ -247,13 +248,53 @@ def test_wraps_inner_kwarg_only():
     assert g(3) == 30
     assert wraps(f)(g)(3) == 3  # yay, g got the f default (not so with functools.wraps!)
 
-    # but this doesn't work
-    with pytest.raises(TypeError):
-        wraps(g)(f)(3)
+    assert wraps(g)(f)(3) == 30
 
     return
 
 
+def test_wraps_preserves_keyword_forwarding():
+    def target(a, b=2, *, c=3):
+        return a, b, c
+
+    @wraps(target)
+    def wrapper(*args, **kwargs):
+        return args, kwargs
+
+    assert wrapper(1) == ((1,), {'b': 2, 'c': 3})
+    assert wrapper(1, b=4, c=5) == ((1,), {'b': 4, 'c': 5})
+
+
+def test_wraps_preserves_positional_forwarding_with_varargs():
+    def target(a, b=2, *args, c=3, **kwargs):
+        return a, b, args, c, kwargs
+
+    @wraps(target)
+    def wrapper(*args, **kwargs):
+        return args, kwargs
+
+    assert wrapper(1, 4, 5, c=6, d=7) == ((1, 4, 5), {'c': 6, 'd': 7})
+
+
+def test_wraps_preserves_positional_only_forwarding():
+    if sys.version_info < (3, 8):
+        pytest.skip('positional-only syntax requires Python 3.8+')
+
+    namespace = {}
+    exec('def target(a=1, /, b=2):\n    return a, b', namespace)
+    target = namespace['target']
+
+    @wraps(target)
+    def wrapper(*args, **kwargs):
+        return args, kwargs
+
+    assert str(inspect.signature(wrapper, follow_wrapped=False)) == '(a=1, /, b=2)'
+    assert wrapper(3, b=4) == ((3,), {'b': 4})
+
+    with pytest.raises(TypeError):
+        wrapper(a=3)
+
+
