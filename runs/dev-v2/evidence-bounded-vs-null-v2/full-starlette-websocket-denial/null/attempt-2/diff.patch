+def test_send_denial_streaming_response() -> None:
+    background_calls = 0
+    messages: list[Message] = []
+
+    async def run_test() -> None:
+        async def stream() -> AsyncIterator[str | bytes]:
+            yield b"foo"
+            yield "bar"
+
+        async def background() -> None:
+            nonlocal background_calls
+            background_calls += 1
+
+        async def receive() -> Message:  # pragma: no cover
+            raise AssertionError("Streaming a denial response must not receive HTTP events.")
+
+        async def send(message: Message) -> None:
+            messages.append(message)
+
+        scope: Scope = {
+            "type": "websocket",
+            "headers": [],
+            "extensions": {"websocket.http.response": {}},
+        }
+        websocket = WebSocket(scope, receive=receive, send=send)
+        response = StreamingResponse(stream(), status_code=401, background=BackgroundTask(background))
+        await websocket.send_denial_response(response)
+
+    anyio.run(run_test)
+
+    assert messages[0]["type"] == "websocket.http.response.start"
+    assert messages[0]["status"] == 401
+    assert all(message["type"] == "websocket.http.response.body" for message in messages[1:])
+    assert b"".join(message["body"] for message in messages[1:]) == b"foobar"
+    assert messages[-1]["more_body"] is False
+    assert background_calls == 1
+
+
+def test_send_denial_file_response(tmp_path: Path) -> None:
+    path = tmp_path / "denial.txt"
+    path.write_bytes(b"file denial")
+    messages: list[Message] = []
+
+    async def run_test() -> None:
+        async def receive() -> Message:  # pragma: no cover
+            raise AssertionError("Sending a file denial response must not receive HTTP events.")
+
+        async def send(message: Message) -> None:
+            messages.append(message)
+
+        scope: Scope = {
+            "type": "websocket",
+            "headers": [],
+            "extensions": {"websocket.http.response": {}, "http.response.pathsend": {}},
+        }
+        websocket = WebSocket(scope, receive=receive, send=send)
+        response = FileResponse(path, status_code=403)
+        await websocket.send_denial_response(response)
+
+    anyio.run(run_test)
+
+    assert messages[0]["type"] == "websocket.http.response.start"
+    assert messages[0]["status"] == 403
+    assert all(message["type"] == "websocket.http.response.body" for message in messages[1:])
+    assert b"".join(message["body"] for message in messages[1:]) == b"file denial"
+    assert messages[-1]["more_body"] is False
+
+
