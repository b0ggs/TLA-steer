+def test_named_text_wrapper_does_not_close_shared_buffer():
+    buffer = BytesIO()
+    first = _NamedTextIOWrapper(buffer, "<first>", "w", encoding="utf-8")
+    second = _NamedTextIOWrapper(buffer, "<second>", "w", encoding="utf-8")
+
+    first.write("first")
+    first.flush()
+    first.close()
+    second.write(" second")
+    second.flush()
+
+    assert not buffer.closed
+    assert buffer.getvalue() == b"first second"
+
+
+def test_stream_mixer_buffers_remain_readable_after_collection():
+    mixer = StreamMixer()
+    mixer.stdout.write(b"stdout")
+    mixer.stderr.write(b"stderr")
+    stdout, stderr, output = mixer.stdout, mixer.stderr, mixer.output
+
+    del mixer
+    gc.collect()
+
+    assert stdout.getvalue() == b"stdout"
+    assert stderr.getvalue() == b"stderr"
+    assert output.getvalue() == b"stdoutstderr"
+
+
+def test_repeated_invocations_with_logging_handlers_isolate_output():
+    logger = logging.getLogger("click.testing.lifecycle")
+    old_handlers = logger.handlers[:]
+    old_level = logger.level
+    old_propagate = logger.propagate
+    logger.handlers.clear()
+    logger.propagate = False
+    logger.setLevel(logging.INFO)
+    handlers = []
+
+    @click.command()
+    def cli():
+        handler = logging.StreamHandler()
+        logger.addHandler(handler)
+        handlers.append(handler)
+        logger.info("hello")
+
+    try:
+        runner = CliRunner()
+
+        for _ in range(3):
+            result = runner.invoke(cli)
+            assert result.exception is None
+            assert result.stderr == "hello\n"
+    finally:
+        for handler in handlers:
+            logger.removeHandler(handler)
+            handler.close()
+
+        logger.handlers[:] = old_handlers
+        logger.setLevel(old_level)
+        logger.propagate = old_propagate
+
+
+def test_repeated_threaded_exceptions_restore_process_streams():
+    old_streams = sys.stdin, sys.stdout, sys.stderr
+
+    @click.command()
+    def cli():
+        with ThreadPoolExecutor(max_workers=1) as executor:
+            executor.submit(click.echo, "thread output").result()
+
+        raise RuntimeError("failure")
+
+    runner = CliRunner()
+
+    for _ in range(3):
+        result = runner.invoke(cli)
+        assert result.output == "thread output\n"
+        assert isinstance(result.exception, RuntimeError)
+        assert (sys.stdin, sys.stdout, sys.stderr) == old_streams
+
+
