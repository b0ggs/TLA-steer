+def test_wraps_preserves_keyword_forwarding():
+    calls = []
+
+    def wrapped(a, b=2, *, c=3):
+        return a, b, c
+
+    @wraps(wrapped)
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+        return wrapped(*args, **kwargs)
+
+    assert wrapper(1, b=4, c=5) == (1, 4, 5)
+    assert wrapper(1, 6) == (1, 6, 3)
+    assert calls == [((1,), {'b': 4, 'c': 5}),
+                     ((1,), {'b': 6, 'c': 3})]
+
+
+@pytest.mark.skipif(sys.version_info < (3, 8),
+                    reason='positional-only syntax requires Python 3.8')
+def test_wraps_preserves_positional_only_forwarding():
+    positional_calls = []
+
+    namespace = {}
+    exec('def positional_only(a=1, /, b=2, *, c=3):\n'
+         '    return a, b, c', namespace)
+    positional_only = namespace['positional_only']
+
+    @wraps(positional_only)
+    def positional_wrapper(*args, **kwargs):
+        positional_calls.append((args, kwargs))
+        return positional_only(*args, **kwargs)
+
+    assert positional_wrapper(4, b=5, c=6) == (4, 5, 6)
+    assert positional_calls == [((4,), {'b': 5, 'c': 6})]
+    assert str(inspect.signature(positional_wrapper, follow_wrapped=False)) == \
+        '(a=1, /, b=2, *, c=3)'
+
+
+def test_wraps_preserves_pre_varargs_forwarding():
+    vararg_calls = []
+
+    def variadic(a, b=2, *args, c=3):
+        return a, b, args, c
+
+    @wraps(variadic)
+    def vararg_wrapper(*args, **kwargs):
+        vararg_calls.append((args, kwargs))
+        return variadic(*args, **kwargs)
+
+    assert vararg_wrapper(1, 4, 5, 6, c=7) == (1, 4, (5, 6), 7)
+    assert vararg_calls == [((1, 4, 5, 6), {'c': 7})]
+
