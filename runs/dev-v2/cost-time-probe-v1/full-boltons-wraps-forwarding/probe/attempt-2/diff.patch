+def test_wraps_preserves_keyword_forwarding():
+    calls = []
+
+    def wrapped(a, b=2, *, c=3, **kwargs):
+        calls.append(((a, b, c), kwargs))
+
+    @wraps(wrapped)
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+
+    wrapper(1, b=3, c=4, extra=5)
+    wrapper(1)
+    assert calls == [
+        ((1,), {'b': 3, 'c': 4, 'extra': 5}),
+        ((1,), {'b': 2, 'c': 3}),
+    ]
+
+
+def test_wraps_keeps_regular_args_positional_before_varargs():
+    calls = []
+
+    def wrapped(a, b=2, *args):
+        calls.append(((a, b) + args, {}))
+
+    @wraps(wrapped)
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+
+    wrapper(1, 3, 4)
+    assert calls == [((1, 3, 4), {})]
+
