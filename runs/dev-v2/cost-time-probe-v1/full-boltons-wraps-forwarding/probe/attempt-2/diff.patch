-    with pytest.raises(TypeError):
-        wraps(g)(f)(3)
+    # Defaulted regular arguments are forwarded by keyword, so a wrapper
+    # with a keyword-only equivalent receives them correctly.
+    assert wraps(g)(f)(3) == 3
 
     return
 
 
