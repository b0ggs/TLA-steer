+def test_wraps_preserves_keyword_forwarding():
+    calls = []
+
+    def target(required, default=2, *, keyword_only=3):
+        pass
+
+    @wraps(target)
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+
+    wrapper(1, default=4, keyword_only=5)
+    assert calls == [((1,), {'default': 4, 'keyword_only': 5})]
+
+
+def test_wraps_varargs_keep_regular_parameters_positional():
+    def target(required, default=2, *args, keyword_only=3, **kwargs):
+        pass
+
+    @wraps(target)
+    def wrapper(*args, **kwargs):
+        return args, kwargs
+
+    assert wrapper(1, 4, 5, keyword_only=6, extra=7) == (
+        (1, 4, 5), {'keyword_only': 6, 'extra': 7})
+
+
+def test_wraps_positional_only_parameters():
+    def target(positional_only, /, default=2):
+        pass
+
+    @wraps(target)
+    def wrapper(*args, **kwargs):
+        return args, kwargs
+
+    assert str(inspect.signature(wrapper, follow_wrapped=False)) == (
+        '(positional_only, /, default=2)')
+    assert wrapper(1, default=3) == ((1,), {'default': 3})
+    with pytest.raises(TypeError):
+        wrapper(positional_only=1)
+
+
