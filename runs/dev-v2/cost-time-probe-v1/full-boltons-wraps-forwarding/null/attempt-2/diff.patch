+def test_wraps_preserves_keyword_forwarding():
+    def target(a, b=2, *, c=3):
+        return a, b, c
+
+    def recorder(*args, **kwargs):
+        return args, kwargs
+
+    wrapped = wraps(target)(recorder)
+
+    assert wrapped(1, b=4, c=5) == ((1,), {'b': 4, 'c': 5})
+
+
+def test_wraps_expected_preserves_keyword_forwarding():
+    def target(a, b=2):
+        return a, b
+
+    def recorder(*args, **kwargs):
+        return args, kwargs
+
+    wrapped = wraps(target, expected=[('c', 3)])(recorder)
+
+    assert wrapped(1, b=4, c=5) == ((1,), {'b': 4, 'c': 5})
+
+
+def test_wraps_required_expected_preserves_existing_default():
+    def target(a, b=2):
+        return a, b
+
+    def recorder(*args, **kwargs):
+        return args, kwargs
+
+    wrapped = wraps(target, expected='c')(recorder)
+
+    assert str(inspect.signature(wrapped, follow_wrapped=False)) == '(a, c, b=2)'
+    assert wrapped(1, 3, b=4) == ((1, 3), {'b': 4})
+
+
+def test_wraps_varargs_avoid_keyword_collision():
+    def target(a, b=2, *values, c=3, **kwargs):
+        return a, b, values, c, kwargs
+
+    def recorder(*args, **kwargs):
+        return args, kwargs
+
+    wrapped = wraps(target)(recorder)
+
+    assert wrapped(1, 4, 5, c=6, extra=7) == (
+        (1, 4, 5), {'c': 6, 'extra': 7})
+
+
+@pytest.mark.skipif(sys.version_info < (3, 8),
+                    reason='positional-only syntax requires Python 3.8')
+def test_wraps_preserves_positional_only_parameters():
+    namespace = {}
+    exec('def target(a, /, b=2, *, c=3):\n    return a, b, c', namespace)
+    target = namespace['target']
+
+    def recorder(*args, **kwargs):
+        return args, kwargs
+
+    wrapped = wraps(target)(recorder)
+
+    assert str(inspect.signature(wrapped, follow_wrapped=False)) == \
+        '(a, /, b=2, *, c=3)'
+    assert wrapped(1, b=4, c=5) == ((1,), {'b': 4, 'c': 5})
+    with pytest.raises(TypeError):
+        wrapped(a=1)
+
