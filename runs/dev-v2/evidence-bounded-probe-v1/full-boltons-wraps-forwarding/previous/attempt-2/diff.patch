+def test_wraps_preserves_keyword_forwarding():
+    calls = []
+
+    def wrapped(a, b=2, *, c=3):
+        return a, b, c
+
+    @wraps(wrapped)
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+        return wrapped(*args, **kwargs)
+
+    assert wrapper(1, b=4, c=5) == (1, 4, 5)
+    assert calls == [((1,), {'b': 4, 'c': 5})]
+
+
+def test_wraps_keeps_regular_args_positional_before_varargs():
+    calls = []
+
+    def wrapped(a, b=2, *args, c=3):
+        return a, b, args, c
+
+    @wraps(wrapped)
+    def wrapper(a, b, *args, **kwargs):
+        calls.append((a, b, args, kwargs))
+        return wrapped(a, b, *args, **kwargs)
+
+    assert wrapper(1, 4, 5, c=6) == (1, 4, (5,), 6)
+    assert calls == [(1, 4, (5,), {'c': 6})]
+
+
+@pytest.mark.skipif(not hasattr((lambda: None).__code__, 'co_posonlyargcount'),
+                    reason='positional-only syntax requires Python 3.8+')
+def test_wraps_keeps_positional_only_args_positional():
+    namespace = {'wraps': wraps}
+    exec("""
+calls = []
+
+def wrapped(a=1, /, b=2):
+    return a, b
+
+@wraps(wrapped)
+def wrapper(*args, **kwargs):
+    calls.append((args, kwargs))
+    return wrapped(*args, **kwargs)
+""", namespace)
+
+    assert namespace['wrapper'](3, b=4) == (3, 4)
+    assert namespace['calls'] == [((3,), {'b': 4})]
+    assert str(inspect.signature(namespace['wrapper'])) == '(a=1, /, b=2)'
+
