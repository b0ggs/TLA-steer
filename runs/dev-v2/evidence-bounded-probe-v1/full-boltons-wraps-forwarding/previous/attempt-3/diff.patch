+def test_wraps_keyword_forwarding():
+    calls = []
+
+    def target(a, b=2, *, c=3):
+        return a, b, c
+
+    @wraps(target, expected=[('extra', 4)])
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+
+    wrapper(1, b=5, c=6, extra=7)
+    assert calls == [((1,), {'b': 5, 'c': 6, 'extra': 7})]
+
+
+def test_wraps_varargs_forwarding():
+    calls = []
+
+    def target(a, b=2, *args, c=3, **kwargs):
+        return a, b, args, c, kwargs
+
+    @wraps(target)
+    def wrapper(a, b, *args, **kwargs):
+        calls.append((a, b, args, kwargs))
+
+    wrapper(1, 4, 5, c=6, d=7)
+    assert calls == [(1, 4, (5,), {'c': 6, 'd': 7})]
+
+
+@pytest.mark.skipif(sys.version_info < (3, 8), reason='positional-only syntax')
+def test_wraps_positional_only_forwarding():
+    namespace = {}
+    exec('def target(a, b=2, /, c=3, *, d=4): pass', namespace)
+    target = namespace['target']
+    calls = []
+
+    @wraps(target)
+    def wrapper(*args, **kwargs):
+        calls.append((args, kwargs))
+
+    wrapper(1, 2, c=5, d=6)
+    assert calls == [((1, 2), {'c': 5, 'd': 6})]
+    assert str(inspect.signature(wrapper, follow_wrapped=False)) == \
+        '(a, b=2, /, c=3, *, d=4)'
+
+    with pytest.raises(TypeError):
+        wrapper(a=1)
+
