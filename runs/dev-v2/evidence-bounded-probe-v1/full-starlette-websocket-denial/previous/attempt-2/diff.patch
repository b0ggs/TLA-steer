+@pytest.mark.anyio
+async def test_send_denial_streaming_response() -> None:
+    messages: list[Message] = []
+    background_calls = 0
+
+    async def receive() -> Message:
+        await anyio.sleep_forever()
+
+    async def send(message: Message) -> None:
+        messages.append(message)
+
+    def background() -> None:
+        nonlocal background_calls
+        background_calls += 1
+
+    scope: Scope = {"type": "websocket", "extensions": {"websocket.http.response": {}}}
+    websocket = WebSocket(scope, receive=receive, send=send)
+    response = StreamingResponse(
+        iter([b"streamed ", b"denial"]),
+        status_code=401,
+        background=BackgroundTask(background),
+    )
+
+    await websocket.send_denial_response(response)
+
+    assert [message["type"] for message in messages] == [
+        "websocket.http.response.start",
+        "websocket.http.response.body",
+        "websocket.http.response.body",
+        "websocket.http.response.body",
+    ]
+    assert messages[0]["status"] == 401
+    assert b"".join(message["body"] for message in messages[1:]) == b"streamed denial"
+    assert background_calls == 1
+
+
+@pytest.mark.anyio
+async def test_send_denial_file_response(tmp_path: Path) -> None:
+    path = tmp_path / "denial.txt"
+    path.write_bytes(b"file denial")
+    messages: list[Message] = []
+
+    async def receive() -> Message:  # pragma: no cover
+        raise RuntimeError("FileResponse should not receive messages")
+
+    async def send(message: Message) -> None:
+        messages.append(message)
+
+    scope: Scope = {
+        "type": "websocket",
+        "headers": [],
+        "extensions": {"websocket.http.response": {}, "http.response.pathsend": {}},
+    }
+    websocket = WebSocket(scope, receive=receive, send=send)
+    response = FileResponse(path, status_code=403)
+
+    await websocket.send_denial_response(response)
+
+    assert [message["type"] for message in messages] == [
+        "websocket.http.response.start",
+        "websocket.http.response.body",
+    ]
+    assert messages[0]["status"] == 403
+    assert messages[1]["body"] == b"file denial"
+
+
