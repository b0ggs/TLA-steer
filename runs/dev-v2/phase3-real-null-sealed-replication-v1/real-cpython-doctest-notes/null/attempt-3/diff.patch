-                exc_msg = traceback.format_exception_only(*exception[:2])[-1]
+                exc_msg = traceback.format_exception_only(*exception[:2])
+                if issubclass(exception[0], SyntaxError):
+                    # SyntaxError formatting starts with indented source
+                    # location details.  Doctest deliberately ignores those,
+                    # but must retain the exception message and any notes.
+                    first = next(
+                        (i for i, line in enumerate(exc_msg)
+                         if line and not line[0].isspace()),
+                        len(exc_msg),
+                    )
+                    exc_msg = exc_msg[first:]
+                exc_msg = ''.join(exc_msg)
                 if not quiet:
                     got += _exception_traceback(exception)
 
