@@ -0,0 +1,90 @@
+import importlib.util
+from pathlib import Path
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location(
+    "repository_doctest", ROOT / "doctest.py"
+)
+doctest = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(doctest)
+
+
+class ExceptionNotesComparisonTests(unittest.TestCase):
+    def assertDoctestFailures(self, expected_failures, source):
+        test = doctest.DocTestParser().get_doctest(
+            source, {}, self.id(), __file__, 0
+        )
+        result = doctest.DocTestRunner(verbose=False).run(
+            test, out=lambda output: None
+        )
+        self.assertEqual(result.failed, expected_failures)
+
+    def test_ordinary_exception_note_is_compared(self):
+        source = '''
+>>> error = ValueError("bad value")
+>>> error.add_note("use a positive value")
+>>> raise error
+Traceback (most recent call last):
+...
+ValueError: bad value
+use a positive value
+'''
+        self.assertDoctestFailures(0, source)
+
+        incorrect_expected_note = source.replace(
+            "use a positive value\n", "use a negative value\n", 1
+        )
+        self.assertDoctestFailures(1, incorrect_expected_note)
+
+    def test_multiple_exception_notes_are_compared(self):
+        source = '''
+>>> error = RuntimeError("operation failed")
+>>> error.add_note("first note")
+>>> error.add_note("second note")
+>>> raise error
+Traceback (most recent call last):
+...
+RuntimeError: operation failed
+first note
+second note
+'''
+        self.assertDoctestFailures(0, source)
+        self.assertDoctestFailures(
+            1, source.replace("first note\n", "wrong first note\n", 1)
+        )
+
+    def test_syntax_error_family_notes_ignore_location(self):
+        for exception_type in ("SyntaxError", "IndentationError", "TabError"):
+            with self.subTest(exception_type=exception_type):
+                source = f'''
+>>> error = {exception_type}("bad syntax", ("actual.py", 4, 2, "x y\\n"))
+>>> error.add_note("syntax note")
+>>> raise error
+Traceback (most recent call last):
+  File "ignored.py", line 999
+    unrelated source
+    ^^^^^^^^^^^^^^^^
+{exception_type}: bad syntax
+syntax note
+'''
+                self.assertDoctestFailures(0, source)
+                self.assertDoctestFailures(
+                    1, source.replace("syntax note\n", "wrong note\n", 1)
+                )
+
+    def test_exception_without_notes_is_unchanged(self):
+        self.assertDoctestFailures(
+            0,
+            '''
+>>> raise LookupError("missing")
+Traceback (most recent call last):
+...
+LookupError: missing
+''',
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
