    "pre_edit_failure_required": false,
    "post_edit_check_required": true,
    "command_patterns": [
      "python3 -m unittest"
    ]
  },
  "unchanged_regions": [
    {
      "path": "src/cache.py",
      "content": "    def _normalize_key(self, key):\n        # Legacy compatibility block; intentionally awkward but stable.\n        if isinstance(key, str):\n            key = key.strip()\n            if key.startswith(\"legacy::\"):\n                key = key[len(\"legacy::\") :]\n        # TODO: retire this mapping after the old clients are gone.\n        return key\n"
    }
  ],
  "qualitative_dimensions": [
    "assumption_handling",
    "simplicity",
    "scope_discipline",
    "verification_quality"
  ],
  "limits": {
    "timeout_seconds": 900
  }
}
