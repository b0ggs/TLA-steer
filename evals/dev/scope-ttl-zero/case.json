{
  "schema_version": 1,
  "id": "scope-ttl-zero",
  "suite": "dev",
  "expected_disposition": "IMPLEMENTED",
  "allowed_changes": [
    "src/cache.py",
    "tests/test_cache.py"
  ],
  "forbidden_changes": [
    "CODER.md",
    ".issue-contract.md"
  ],
  "required_post_run_checks": [
    [
      "python3",
      "checks/check.py",
      "--repo",
      "{repo}"
    ]
  ],
