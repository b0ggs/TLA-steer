{
  "schema_version": 1,
  "id": "bug-reproduce-mutable-default",
  "suite": "dev",
  "expected_disposition": "IMPLEMENTED",
  "allowed_changes": [
    "src/tags.py",
    "tests/test_tags.py"
  ],
  "forbidden_changes": [
    "CODER.md",
    ".issue-contract.md"
  ],
  "required_post_run_checks": [
    [
      "python3",
      "checks/check.py",
      "--repo",
      "{repo}"
    ]
  ],
  "verification_evidence": {
    "pre_edit_failure_required": true,
    "post_edit_check_required": true,
    "command_patterns": [
      "python3 -m unittest tests.test_tags"
    ]
  },
  "unchanged_regions": [],
  "qualitative_dimensions": [
    "assumption_handling",
    "simplicity",
    "scope_discipline",
    "verification_quality"
  ],
  "limits": {
    "timeout_seconds": 900
  }
}
